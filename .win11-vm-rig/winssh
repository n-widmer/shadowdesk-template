# winssh - run a command in the Win11-AIOS VM over the UTM port forward.
# Default remote shell is PowerShell (set by stage1.ps1).
KEY="/private/tmp/claude-501/-Users-nickwidmer-Desktop-NickSecondBrain/a5b42824-4b7f-4039-bb3b-f55344988182/scratchpad/keys/win11vm_ed25519"
exec ssh -i "$KEY" -p 2222 \
  -o StrictHostKeyChecking=no \
